BOT_TOKEN=
ADMIN_IDS=
# Локально можно оставить пустым — будет ./bot.db
# Railway: Variable Reference на Postgres → DATABASE_URL (обязательно!)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

VALIDEMAIL_API_KEY_1=
VALIDEMAIL_API_KEY_2=
# VALIDEMAIL_API_KEYS=key1,key2,...  (6 ключей → 6 параллельных потоков)
# VALIDEMAIL_CONCURRENCY=12          (общий лимит; на ключ ≈ concurrency/keys)
# VALIDEMAIL_CONCURRENCY_PER_KEY=6   (опционально: фикс. параллель на ключ)
# VALIDEMAIL_API_TIMEOUT=15          (query timeout 2–30, validemail.co)
# VALIDEMAIL_MAX_RETRIES=3           (повтор при 429/timeout/connection_error)
# GLOBAL_SUBJECT_TEMPLATE=OFFER

# Narkologia / APEX API (docs.domainforapi.com)
# По умолчанию: traffic.withhatetoapi.cc, резерв: domainforapi.com
# NARKOLOGIA_API_BASE=https://traffic.withhatetoapi.cc
# Общий X-Team-Key команды Narkologia (Бельгия)
NARKOLOGIA_TEAM_API_KEY=
# Совместимость со старым именем переменной:
# AQUA_TEAM_API_KEY=
# URL картинки по умолчанию (если в оффере нет item_photo)
# AQUA_DEFAULT_IMAGE_URL=https://example.com/placeholder.jpg
# AQUA_DEFAULT_SERVICE=2dehands_be

DEEPSEEK_API_KEY=
TRANSLATE_PROVIDER=auto
